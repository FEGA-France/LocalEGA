{
    "version": 1,
    "root": {
        "level": "NOTSET",
        "handlers": [
            "noHandler"
        ]
    },
    "loggers": {
        "__main__": {
            "level": "DEBUG",
            "handlers": [ "console" ],
            "propagate": true
        },
        "code": {
            "level": "DEBUG",
            "handlers": [ "console" ],
            "propagate": true
        },
        "pamqp": {
            "level": "CRITICAL",
            "handlers": [ "console" ]
        },
        "aiormq": {
            "level": "CRITICAL",
            "handlers": [ "console" ]
        }
    },
    "handlers": {
        "noHandler": {
            "class": "logging.NullHandler",
            "level": "NOTSET"
        },
        "console": {
            "class": "logging.StreamHandler",
            "formatter": "simple",
            "stream": "ext://sys.stderr"
        }
    },
    "formatters": {
        "simple": {
            "format": "[{pid}][{levelname:^6}][{correlation_id:>20}] {message}",
            "style": "{"
        }
    }
}
