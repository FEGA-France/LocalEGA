[DEFAULT]
logger = /etc/ega/logger.json

source = staging.posix
destination = vault.s3

skip_backup = False
backup = backup.posix


[broker]
connection = amqp://admin:__CHANGE-ME__@mq:5672/%2F

exchange = lega
queue = archive
qos = 10

[staging.posix]
type = posix

# Where the files are.
# We'll append <username>/path/to/file
rootdir = /ega/staging


[vault.posix]
type = posix
rootdir = /ega/vault

[vault.s3]
type = s3
endpoint = http://lega-vault:9000
bucket = vault
access_key = ...
secret_key = ...


[backup.posix]
type = posix
rootdir = /ega/backup

[backup.s3]
type = s3
endpoint = http://lega-backup:9000
bucket = backup
access_key = ...
secret_key = ...


# [data]
# type = posix
# rootdir = /ega/data

# [tools]
# type = posix
# rootdir = /ega/tools


