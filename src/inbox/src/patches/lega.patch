--- openssh.old/sftp-common.c	2026-07-29 11:38:30
+++ openssh.new/sftp-common.c	2026-10-08 17:56:35
@@ -176,6 +176,15 @@
 		    (r = sshbuf_put_u32(b, a->mtime)) != 0)
 			return r;
 	}
+#ifdef LEGA_WITH_SHA256
+	if (a->flags & SSH2_FILEXFER_ATTR_EXTENDED) {
+	  /* Adding 1 extension: the SHA256 checksum */
+	  if ((r = sshbuf_put_u32(b, 1)) != 0 ||
+	      (r = sshbuf_put_cstring(b, "sha256")) != 0 ||
+	      (r = sshbuf_put_string(b, a->sha256, sizeof(a->sha256))) != 0)
+		  return r;
+	}
+#endif
 	return 0;
 }
 
